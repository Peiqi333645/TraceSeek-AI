# 只忽略程序运行时在仓库根目录生成的用户数据。
# 不要写成 data/，否则 frontend/src/data/ 的内置全国区划也会被忽略。
/data/
*.pyc
__pycache__/
.env
.venv/
*.egg-info/
.pytest_cache/
tests/fixtures/*.real.json
node_modules/
src/xianyu_crawler/web/static/
dist/
build/
*.dmg
*.spec.bak

# 图标中间产物(由 packaging/make_icon.py 生成)
packaging/appicon.iconset/
